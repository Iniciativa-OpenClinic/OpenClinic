# ============================================================
# 🔐 1. SECRETS-FIRST ARCHITECTURE (Provider / Driver Pattern)
# ============================================================
# Database connection parameters (host, port, database, user, password)
# are fully encapsulated inside structured JSON secrets (e.g. ./secrets/<name>.json).
# They do NOT need to be defined in .env.

# Active secrets provider (CANONICAL: 'file', 'gsm', or 'aws'. 'env' is NOT supported):
#   - 'file' : Docker Secrets (/run/secrets/) or local files (./secrets/)
#   - 'gsm'  : Google Cloud Secret Manager (reads secrets dynamically via GCP SA)
#   - 'aws'  : AWS Secrets Manager (reads secrets dynamically via AWS IAM)
SECRETS_PROVIDER=file

# Logical secret identifiers (resolved dynamically by file, gsm, or aws):
#   - In 'file' mode:
#       DB_APP_SECRET_NAME resolves to ./secrets/<name>.json or /run/secrets/<name>
#       DB_OWNER_SECRET_NAME resolves to ./secrets/<name>.json or /run/secrets/<name>
#       JWT_SECRET_NAME resolves to ./secrets/<name>.txt or /run/secrets/<name>
DB_APP_SECRET_NAME=database-secret-app
DB_OWNER_SECRET_NAME=database-secret-owner
JWT_SECRET_NAME=jwt-secret

# Base directory for local secrets in 'file' mode (defaults to ./secrets)
SECRETS_DIR=./secrets

# --- [Provider: gsm] (Google Cloud Secret Manager - prepared) ---
# GCP_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# --- [Provider: aws] (AWS Secrets Manager - prepared) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ============================================================
# 🌐 2. APPLICATION SERVER & WEBAPP
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
NODE_ENV=development
LOG_LEVEL=info
