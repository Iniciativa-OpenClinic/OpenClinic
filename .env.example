# -- Database (runtime  -  role com permissões DML only) --
DATABASE_URL=postgresql://openclinic_app:temp1234@localhost:5432/openclinic

# -- Database (migrations  -  role owner com permissões DDL) --
DATABASE_OWNER_URL=postgresql://openclinic_owner:temp1234@localhost:5432/openclinic

# Remote maintenance only. Never used by runtime or as a local fallback.
# REMOTE_DATABASE_OWNER_URL=postgresql://openclinic_owner:CHANGE_ME@HOST:5432/openclinic?sslmode=require
# Optional Docker container used ONLY as a PostgreSQL client when pg_dump/pg_restore are absent.
# PG_CLIENT_CONTAINER=openclinic-postgres

# -- Database Migrations Test Suite (Optional - Disposable PostgreSQL connection with CREATEDB for test:migrations) --
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:temp1234@localhost:5432/postgres

# -- Security --
JWT_SECRET_KEY=openclinic-dev-only-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -- Server --
APP_HOST=0.0.0.0
APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=info
