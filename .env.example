# ============================================================
# 🐘 1. DIRECT ATOMIC CONFIGURATION (SECRETS_PROVIDER=env)
# ============================================================
# Used directly when SECRETS_PROVIDER=env.
# DATABASE_URL is NEVER stored in .env; it is synthesized dynamically
# by the application from atomic components (DB_USER, DB_PASS, DB_HOST, DB_PORT, DB_NAME).
# Runtime API connects strictly via DB_USER (restricted DML role).
# Database migrations (DDL) NEVER use .env credentials; they strictly require
# an owner secret from the active secrets provider (e.g. ./secrets/database-secret-owner.credentials.json).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openclinic

# Application runtime user (DML: SELECT, INSERT, UPDATE, DELETE)
DB_USER=openclinic_app
DB_PASS="replace-with-a-local-development-password"

# JWT signing key (used directly when SECRETS_PROVIDER=env)
JWT_KEY="generate-a-random-key-with-at-least-32-characters"

# ============================================================
# 🔐 2. SECRETS ARCHITECTURE (Provider / Driver Pattern)
# ============================================================
# Active secrets provider:
#   - 'env'  : Direct atomic variables above (DB_HOST, DB_USER, DB_PASS, JWT_KEY)
#   - 'file' : Docker Swarm mounts (/run/secrets/) or local files (./secrets/)
#   - 'gsm'  : Google Cloud Secret Manager (reads secrets dynamically via GCP SA)
#   - 'aws'  : AWS Secrets Manager (reads secrets dynamically via AWS IAM)
SECRETS_PROVIDER=env

# Logical secret identifiers (resolved dynamically by file, gsm, or aws):
#   - In 'file' mode:
#       DB_APP_SECRET_NAME resolves to ./secrets/database-secret-app.credentials.json or /run/secrets/database-secret-app
#       DB_OWNER_SECRET_NAME resolves to ./secrets/database-secret-owner.credentials.json or /run/secrets/database-secret-owner
#       JWT_SECRET_NAME resolves to ./secrets/jwt-secret.credentials.json or /run/secrets/jwt-secret
DB_APP_SECRET_NAME=database-secret-app
DB_OWNER_SECRET_NAME=database-secret-owner
JWT_SECRET_NAME=jwt-secret

# Base directory for local secrets in 'file' mode (defaults to ./secrets)
SECRETS_DIR=./secrets

# --- [Provider: gsm] (Google Cloud Secret Manager - prepared) ---
# GCP_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# --- [Provider: aws] (AWS Secrets Manager - prepared) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ============================================================
# 🌐 3. APPLICATION SERVER
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
NODE_ENV=development
LOG_LEVEL=info
