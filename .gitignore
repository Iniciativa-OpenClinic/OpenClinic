# Sistema operacional
.DS_Store
Thumbs.db

# Editores e IDEs
.vscode/
.idea/
*.swp

# Segredos e configuração local
# Nunca versione credenciais. Arquivos de exemplo (.env.example) são versionados; os reais, não.
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log

# Dados locais de desenvolvimento
# O projeto trabalha exclusivamente com dados fictícios (ver docs/decisions/0007).
# Ainda assim, dumps de banco não pertencem ao repositório.
*.sql.gz
*.dump

# Entradas específicas de linguagem e framework serão adicionadas quando a
