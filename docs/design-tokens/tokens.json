      "mono": {
        "$value": [
          "Atkinson Hyperlegible Mono",
          "ui-monospace",
          "Consolas",
          "monospace"
        ],
        "$description": "Codes and identifiers — mitigates Lexend's I/l ambiguity"
      }
    },
    "size": {
