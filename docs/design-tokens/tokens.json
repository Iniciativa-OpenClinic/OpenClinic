      "700": {
        "$value": "#1B5D6E",
        "$description": "Primary hover/pressed"
      }
    },
    "blue": {
      "100": {
        "$value": "#E8EEF7"
      },
      "400": {
        "$value": "#7AA3D8"
      },
      "500": {
        "$value": "#185795",
        "$description": "Logo blue — canonical, extracted from logo.png pixels (7.4:1 on white)"
