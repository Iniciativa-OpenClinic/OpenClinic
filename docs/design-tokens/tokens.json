  "shadow": {
    "$type": "shadow",
    "$description": "Elevation comes from surface contrast + border, not shadow (extracted from references + NN/g flat-2.0 findings). Real shadow ONLY on floating elements.",
    "none": {
      "$value": "none"
    },
    "raised": {
      "$value": "0 1px 2px rgba(22, 41, 47, 0.06)",
      "$description": "Optional, barely-there — interactive cards"
    },
    "overlay": {
      "$value": "0 8px 24px rgba(22, 41, 47, 0.16)",
      "$description": "The only real shadow: menus, popovers, dialogs"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Two-speed system: micro-interactions fast (high-frequency reception work), spatial changes measured. Nothing above 250ms (Doherty threshold headroom).",
      "fast": {
        "$value": "100ms",
        "$description": "Hover, press, toggle, color change"
      },
      "base": {
        "$value": "160ms",
        "$description": "Panels, dropdowns, spatial movement"
      },
      "slow": {
        "$value": "220ms",
        "$description": "Dialogs, page-level transitions — ceiling, use sparingly"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "linear": {
        "$value": [
          0,
          0,
          1,
          1
        ],
        "$description": "Color-only transitions"
      }
    }
  },
