  "radius": {
    "$type": "dimension",
    "$description": "Center of gravity extracted from founder references: ~8px controls, ~12px cards, pill for chips/search/avatars",
    "xs": {
      "$value": "4px"
    },
    "sm": {
      "$value": "6px"
