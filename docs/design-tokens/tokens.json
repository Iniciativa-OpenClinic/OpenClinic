      "600": {
        "$value": "#1E7A56",
        "$description": "Success (5.3:1 on white)"
      },
      "900": {
        "$value": "#17352A"
      }
    },
    "amber": {
      "100": {
        "$value": "#FAF0DC"
      },
      "300": {
        "$value": "#E8C27A"
      },
      "700": {
        "$value": "#8F5F00",
        "$description": "Warning (5.5:1 on white)"
      },
      "900": {
        "$value": "#3A2F1B"
      }
    },
    "red": {
      "100": {
        "$value": "#F9E9E7"
      },
      "300": {
        "$value": "#E2A2A2"
      },
      "600": {
        "$value": "#B42318",
