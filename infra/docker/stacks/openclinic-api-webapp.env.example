# =============================================================================
# 🚀 OPENCLINIC - DECOUPLED APPLICATION STACK ENVIRONMENT VARIABLES (API + WEBAPP)
# =============================================================================
# File: infra/docker/stacks/openclinic-api-webapp.env.example
# Paste these variables into the "Environment variables" section of the Portainer
# stack or save as .env when deploying via Docker CLI.
# =============================================================================

# === DOMAIN & ROUTING (TRAEFIK) ===
DOMAIN_NAME=openclinic.example.com

# === ENVIRONMENT TIER (dev | stage | prod) ===
# Standardized 3-letter tier identifier. Used for Swarm Secret resolution.
ENVIRONMENT=prod

# === RUNTIME NODE ENVIRONMENT ===
# Note: In Node.js / Fastify ecosystem, both 'prod' and 'stage' typically run
# with NODE_ENV=production to activate engine-level optimizations, pre-compiled
# assets, and strict security headers. Use NODE_ENV=development only when debugging.
NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=3000

# === DATABASE & SECRETS CONFIGURATION (SECRETS-FIRST ARCHITECTURE) ===
# All database connection parameters (host, port, database, user, password) are
# fully encapsulated within Docker Secrets (see DB_APP_SECRET_NAME below).
# In compliance with LGPD and HIPAA, no database parameters or credentials exist in this file.

# === DOCKER IMAGES (CONTAINER REGISTRY) ===
API_IMAGE=openclinic/openclinic-api
WEBAPP_IMAGE=openclinic/openclinic-webapp
IMAGE_TAG=latest

# === SECRETS CONFIGURATION (KEBAB-CASE) ===
# Defaults automatically interpolate based on ENVIRONMENT (e.g. openclinic-${ENVIRONMENT}-...):
#
# Production (ENVIRONMENT=prod):
# DB_APP_SECRET_NAME=openclinic-prod-app-postgres-credentials
# JWT_SECRET_NAME=openclinic-prod-jwt-secret
#
# Staging (ENVIRONMENT=stage):
# DB_APP_SECRET_NAME=openclinic-stage-app-postgres-credentials
# JWT_SECRET_NAME=openclinic-stage-jwt-secret
#
# Development (ENVIRONMENT=dev):
# DB_APP_SECRET_NAME=openclinic-dev-app-postgres-credentials
# JWT_SECRET_NAME=openclinic-dev-jwt-secret

DB_APP_SECRET_NAME=openclinic-prod-app-postgres-credentials
JWT_SECRET_NAME=openclinic-prod-jwt-secret

# === LOGGING & RUNTIME ===
LOG_LEVEL=info

# === OPTIONAL RUNTIME OVERRIDES ===
# CORS_ALLOWED_ORIGINS=https://openclinic.example.com
