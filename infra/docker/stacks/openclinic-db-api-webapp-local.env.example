# =============================================================================
# 💻 OPENCLINIC - LOCAL DEVELOPMENT STACK ENVIRONMENT VARIABLES
# =============================================================================
# File: infra/docker/stacks/openclinic-db-api-webapp-local.env.example
# Used for frictionless local developer onboarding ("1 command quickstart").
# =============================================================================

# === POSTGRESQL ENGINE PARAMETERS (LOCAL CONTAINER) ===
# Note: The REST API loads its database credentials strictly from
# ./secrets/openclinic-dev-app-postgres-credentials.json (SECRETS_PROVIDER=file).
# The variables below configure the local PostgreSQL container and host port binding:
DB_PORT=5432
DB_NAME=openclinic
DB_USER=postgres
DB_PASS=openclinic_postgres_password

# === REST API BACKEND ===
APP_HOST=0.0.0.0
APP_PORT=3000
NODE_ENV=development
SECRETS_PROVIDER=file
DB_APP_SECRET_NAME=openclinic-dev-app-postgres-credentials
JWT_SECRET_NAME=openclinic-dev-jwt-secret
LOG_LEVEL=info

# === WEBAPP FRONTEND ===
# If host port 80 is occupied by another service on your machine, change to 8080
WEBAPP_PORT=80

# === OPTIONAL RUNTIME OVERRIDES ===
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost
