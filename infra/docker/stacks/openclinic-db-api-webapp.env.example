# =============================================================================
# 🛡️ OPENCLINIC - STANDALONE PRODUCTION VPS STACK ENVIRONMENT VARIABLES
# =============================================================================
# File: infra/docker/stacks/openclinic-db-api-webapp.env.example
# Used for dedicated single-node VPS environments (PostgreSQL + API + WebApp + Traefik).
# =============================================================================

# === DOMAIN & ROUTING (TRAEFIK) ===
DOMAIN_NAME=openclinic.example.com

# === ENVIRONMENT TIER (dev | stage | prod) ===
ENVIRONMENT=prod

# === RUNTIME NODE ENVIRONMENT ===
NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=3000

# === DATABASE & SECRETS CONFIGURATION (SECRETS-FIRST ARCHITECTURE) ===
# In compliance with LGPD and HIPAA, superuser passwords and database connection
# parameters (host, port, database, user, password) are NEVER stored in plaintext
# inside .env files. All sensitive credentials are provided exclusively via Docker Secrets.
#
# Production (ENVIRONMENT=prod):
# DB_ROOT_SECRET_NAME=openclinic-prod-postgres-password
# DB_APP_SECRET_NAME=openclinic-prod-app-postgres-credentials
# JWT_SECRET_NAME=openclinic-prod-jwt-secret
#
# Staging (ENVIRONMENT=stage):
# DB_ROOT_SECRET_NAME=openclinic-stage-postgres-password
# DB_APP_SECRET_NAME=openclinic-stage-app-postgres-credentials
# JWT_SECRET_NAME=openclinic-stage-jwt-secret
#
# Development (ENVIRONMENT=dev):
# DB_ROOT_SECRET_NAME=openclinic-dev-postgres-password
# DB_APP_SECRET_NAME=openclinic-dev-app-postgres-credentials
# JWT_SECRET_NAME=openclinic-dev-jwt-secret

DB_ROOT_SECRET_NAME=openclinic-prod-postgres-password
DB_APP_SECRET_NAME=openclinic-prod-app-postgres-credentials
JWT_SECRET_NAME=openclinic-prod-jwt-secret

# === DATABASE METADATA (NON-SENSITIVE) ===
DB_PORT=5432
DB_NAME=openclinic
DB_USER=postgres

# === DOCKER IMAGES (CONTAINER REGISTRY) ===
API_IMAGE=openclinic/openclinic-api
WEBAPP_IMAGE=openclinic/openclinic-webapp
IMAGE_TAG=latest

# === LOGGING & RUNTIME ===
LOG_LEVEL=info

# === OPTIONAL RUNTIME OVERRIDES ===
# CORS_ALLOWED_ORIGINS=https://openclinic.example.com
