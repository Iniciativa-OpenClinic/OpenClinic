# =============================================================================
# 🚀 OPENCLINIC - EPHEMERAL DATABASE BOOTSTRAP ENVIRONMENT VARIABLES
# =============================================================================
# File: infra/docker/stacks/openclinic-db-init.env.example
# Used strictly during the one-time bootstrap phase of the persistent volume.
# =============================================================================

# === DATABASE INITIALIZATION PARAMETERS ===
DB_PORT=5432
DB_NAME=openclinic
DB_USER=postgres

# Superuser (postgres) Password:
# -----------------------------------------------------------------------------
# 💻 LOCAL DEVELOPMENT:
#    Leave DB_PASS= empty and keep POSTGRES_HOST_AUTH_METHOD=trust below for
#    quick, passwordless developer onboarding during initial volume provisioning.
#
# 🛡️ REMOTE / PRODUCTION / VPS BOOTSTRAP (MANDATORY SECURITY REQUIREMENT):
#    NEVER leave DB_PASS empty or use 'trust' in remote/production environments!
#    1. Set a strong, randomly generated superuser password:
#       DB_PASS=your_strong_cryptographic_password
#    2. Change POSTGRES_HOST_AUTH_METHOD to scram-sha-256 (see below).
#    Once cluster initialization completes, this bootstrap container is stopped
#    and removed; the operational stack (openclinic-db.yml) takes over without
#    needing root credentials in environment variables.
# -----------------------------------------------------------------------------
DB_PASS=

# Note on DB_HOST:
# DB_HOST is not defined here because this container runs the bootstrap PostgreSQL server.

# === AUTHENTICATION METHOD (pg_hba.conf) ===
# 💻 For local development (zero friction / passwordless):
POSTGRES_HOST_AUTH_METHOD=trust

# 🛡️ For remote / production / VPS bootstrap (MANDATORY: uncomment and use):
# POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# === NETWORKS & VOLUMES ===
POSTGRES_NETWORK_NAME=postgres_network
POSTGRES_VOLUME_NAME=openclinic_postgres_data
