# =============================================================================
# 🐘 OPENCLINIC - DECOUPLED STATEFUL DATABASE STACK ENVIRONMENT VARIABLES
# =============================================================================
# File: infra/docker/stacks/openclinic-db.env.example
# Used for operational runtime of PostgreSQL (stateful persistence layer).
# =============================================================================

# === ENVIRONMENT TIER (dev | stage | prod) ===
ENVIRONMENT=prod

# === DATABASE PARAMETERS (POSTGRESQL METADATA) ===
DB_PORT=5432
DB_NAME=openclinic
DB_USER=postgres

# === SECRETS-FIRST CONFIGURATION (LGPD / HIPAA COMPLIANCE) ===
# In accordance with the Secrets-First architecture, no superuser passwords
# are stored in plaintext inside .env files. Instead, the PostgreSQL engine
# mounts a Docker Secret into /run/secrets/postgres_password and reads it via
# POSTGRES_PASSWORD_FILE.
#
# Production (ENVIRONMENT=prod):
# DB_ROOT_SECRET_NAME=openclinic-prod-postgres-password
#
# Staging (ENVIRONMENT=stage):
# DB_ROOT_SECRET_NAME=openclinic-stage-postgres-password
#
# Development (ENVIRONMENT=dev):
# DB_ROOT_SECRET_NAME=openclinic-dev-postgres-password

DB_ROOT_SECRET_NAME=openclinic-prod-postgres-password

# Note on DB_HOST:
# DB_HOST is not defined here because this stack runs the PostgreSQL server itself.
# Client services (such as openclinic-api-webapp) connect to this server using:
# DB_HOST=postgres (or DB_HOST=openclinic-db via network alias).

# === NETWORKS & VOLUMES ===
POSTGRES_NETWORK_NAME=postgres_network
POSTGRES_VOLUME_NAME=openclinic_postgres_data
