# =============================================================================
# 📄 OPENCLINIC - PRODUCTION ENVIRONMENT VARIABLES (PORTAINER STACK ENV)
# =============================================================================
# Paste these variables into the "Environment variables" section of the Portainer Stack.
# =============================================================================

# === DOMAIN & ROUTING ===
DOMAIN_NAME=openclinic.example.com

# === DOCKER IMAGES (DOCKER HUB / REGISTRY) ===
API_IMAGE=openclinic/openclinic-api
WEBAPP_IMAGE=openclinic/openclinic-webapp
IMAGE_TAG=latest

# === DATABASE (POSTGRESQL ON postgres_network - DML Runtime Only) ===
# Name of an existing Swarm Secret containing the credentials JSON or PostgreSQL URL.
# The stack mounts this secret as "database-secret-app" inside the container.
DB_APP_SECRET_SWARM_NAME=database-secret-app

# === SECURITY & JWT TOKENS ===
# Name of an existing Swarm Secret containing the JWT signing key.
# The stack mounts this secret as "jwt-secret" inside the container.
JWT_SECRET_SWARM_NAME=jwt-secret
LOG_LEVEL=info
