# =============================================================================
# 📄 OPENCLINIC - PRODUCTION ENVIRONMENT VARIABLES (PORTAINER STACK ENV)
# =============================================================================
# Cole estas variáveis na seção "Environment variables" da Stack no Portainer.
# =============================================================================

# === DOMÍNIO & ROTEAMENTO ===
DOMAIN_NAME=openclinic.example.com

# === IMAGENS DOCKER (DOCKER HUB) ===
WEBAPP_IMAGE=openclinic/openclinic-webapp
API_IMAGE=openclinic/openclinic-api
IMAGE_TAG=latest

# === BANCO DE DADOS (POSTGRESQL NA REDE postgres_network) ===
DB_HOST=postgres
DB_PORT=5432
DB_NAME=openclinic
DB_APP_USER=openclinic_app
DB_OWNER_USER=openclinic_owner
DB_PASSWORD=temp1234

# === SEGURANÇA & TOKENS JWT ===
JWT_SECRET_KEY=openclinic-prod-jwt-secret-key-change-in-portainer-min32chars
LOG_LEVEL=info
